    "zh": [
      "文档权限与预测ID完整",
      "引用支持/越权/缺资料行为按契约检查"
    ],
    "en": [
      "Reconcile the complete result with the supplied input IDs and values.",
      "A private source must not enter a member answer. This is a blocking regression."
    ]
  },
