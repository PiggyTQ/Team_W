  "brief": {
    "zh": "以实施、后端、前端和测试角色轮换交付报名流程。消费同一版email接口契约，在实际界面与本机服务暴露旧mail字段错误，修订后共同验收。",
    "en": "Rotate implementation, backend, frontend and testing roles to deliver an activity registration flow. Consume a versioned field contract and repair the recorded mismatch."
  },
  "outputs": {
    "zh": [
      "需求到验收的追溯",
      "服务/界面/测试与修改包"
    ],
    "en": [
      "Contract",
      "runnable UI/service",
      "acceptance trace and revised role handoffs"
    ]
  },
  "checks": {
    "zh": [
      "界面调用对应版本接口，业务记录一致",
      "缺陷意见有对应修改和复验"
    ],
    "en": [
      "Reconcile the complete result with the supplied input IDs and values.",
      "A legacy mail field sent to the email-field contract must fail joint acceptance. This is a blocking regression."
    ]
  },
  "failure": {
    "zh": "接口字段变更不通知前端造成流程失败应在联合验收暴露",
