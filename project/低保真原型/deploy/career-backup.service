[Unit]
Description=Back up and restore-check Career Growth database
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /srv/career-growth/source/server/backup-db.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/career-growth
