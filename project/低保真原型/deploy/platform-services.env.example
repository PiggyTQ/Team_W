# Keep the real file outside source control, root-only 0600; never put secrets in VITE_*.
# Runtime ops read token: independently generated, at least 32 characters.
OPS_READ_TOKEN=
# Optional alert webhook. No remote messages until configured and approved.
OPS_ALERT_URL=
OPS_ALERT_TOKEN=
# Mail webhook contract: POST {deliveryId,to,from,purpose,url}, Bearer token,
# 2xx acknowledgement, stable Idempotency-Key. Provider-specific bridge may be needed.
MAIL_ENABLED=0
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
MAIL_FROM=
# 32 random bytes encoded as 64 hex characters; preserve separately from backups.
MAIL_OUTBOX_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_REMOTE_ENABLED=0
BACKUP_REMOTE_URL=
BACKUP_REMOTE_TOKEN=
